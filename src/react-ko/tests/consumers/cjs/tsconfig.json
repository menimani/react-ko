{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "react-ko": ["../../../dist/index.d.cts"]
    },
    "strict": true,
    "noEmit": true,
    // knockout's own typings declare namespaces with the `module` keyword, which
    // TypeScript 6 rejects (TS1540) in every checked .d.ts, so lib files are skipped.
    "skipLibCheck": true
  },
  "files": ["index.ts"]
}
